{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-video-production/schemas/audio.schema.json",
  "title": "AudioCue",
  "description": "Musik- oder Soundeffekt-Cue. Output des Voice & Audio Agents. Referenziert sceneId (und optional shotId). Provider-agnostisch, damit später Musik-/SFX-Generatoren oder -Bibliotheken angebunden werden können.",
  "type": "object",
  "required": ["audioId", "sceneId", "type"],
  "additionalProperties": false,
  "properties": {
    "audioId": { "type": "string" },
    "sceneId": { "type": "string", "description": "Verweis auf scenes[].sceneId." },
    "shotRef": { "type": "string" },
    "type": { "enum": ["music", "sfx", "ambience", "riser", "impact", "silence"] },
    "description": { "type": "string", "description": "Was zu hören ist / gewünschte Wirkung." },
    "mood": { "type": "string" },
    "genre": { "type": "string", "description": "Nur bei music." },
    "bpm": { "type": "number" },
    "timing": {
      "type": "object",
      "properties": {
        "startSec": { "type": "number" },
        "durationSec": { "type": "number" },
        "loop": { "type": "boolean" }
      }
    },
    "mix": {
      "type": "object",
      "description": "Mischung relativ zur Voice.",
      "properties": {
        "levelDb": { "type": "number", "description": "Relativer Pegel (z. B. -18 dB unter Voice)." },
        "ducking": { "type": "boolean", "description": "Musik unter Voiceover absenken." },
        "fadeInMs": { "type": "number" },
        "fadeOutMs": { "type": "number" }
      }
    },
    "prompt": { "type": "string", "description": "Generierungs-Prompt (falls Musik/SFX generiert wird)." },
    "providerOverrides": { "type": "object", "additionalProperties": true },
    "output": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "queued", "generating", "done", "failed", "library"], "default": "pending" },
        "audioUrl": { "type": "string" },
        "audioPath": { "type": "string" },
        "provider": { "type": "string" }
      }
    }
  }
}
